rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Validation Helpers
    function validateString(val) {
      return val is string && val.size() > 0;
    }

    function validateNumber(val, min) {
      return (val is number || val is int) && val >= min;
    }

    // 1. USERS: Only access own document
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. PRODUCTS: Name string, price > 0, stock >= 0, ownerId required
    match /products/{productId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validateString(request.resource.data.name) &&
                    validateNumber(request.resource.data.price, 0.01) &&
                    validateNumber(request.resource.data.stock, 0);
      allow update: if isSignedIn() && 
                    isOwner(resource.data.ownerId) &&
                    isOwner(request.resource.data.ownerId) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || validateString(request.resource.data.name)) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['price']) || validateNumber(request.resource.data.price, 0.01)) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock']) || validateNumber(request.resource.data.stock, 0));
      allow delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 3. ACTIVITIES: Only create (log) entry, no edit/delete
    match /activities/{activityId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update, delete: if false; 
    }

    // 4. SALES: Total > 0, quantity >= 1, ownerId required
    match /sales/{saleId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validateNumber(request.resource.data.total, 0.01) &&
                    (request.resource.data.qty is number ? validateNumber(request.resource.data.qty, 1) : true);
      allow update, delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 5. EXPENSES: Amount > 0, category string
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validateNumber(request.resource.data.amount, 0.01) &&
                    validateString(request.resource.data.category);
      allow update, delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 6. CUSTOMERS: Name string, phone optional string
    match /customers/{customerId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isOwner(request.resource.data.ownerId) &&
                    validateString(request.resource.data.name) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) || request.resource.data.phone is string);
      allow update, delete: if isSignedIn() && isOwner(resource.data.ownerId);
    }

    // 7. WALLET: Only owner
    match /wallet/{docId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        (request.resource != null && request.resource.data.ownerId == request.auth.uid) ||
        (docId == request.auth.uid)
      );
    }

  }
}
